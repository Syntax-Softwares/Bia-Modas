# Copie para .env e preencha. O .env NUNCA vai pro git.
#   cp .env.example .env

# ---- aplicacao ----
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# ---- banco (MySQL) ----
# o schema e o seed estao em database/migrations/ e database/seeds/
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=biamodas
DB_USER=
DB_PASS=
DB_CHARSET=utf8mb4

# ---- sessao ----
SESSION_NAME=BIAMODAS_SESSID
